# ========== Tavily 联网搜索工具 ==========
TAVILY_API_KEY=your_tavily_api_key

# ========== 硅基流动 SiliconFlow 专属配置 ==========
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash

# ========== 通用 LLM 配置（兼容回退） ==========
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash

# ========== Qdrant 向量数据库 ==========
# 云服务示例: https://xxx.cloud.qdrant.io:6333
# 本地示例:   http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ========== Neo4j 图数据库（连接失败自动回退内存图） ==========
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ========== 嵌入（Embedding）配置 ==========
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=your_embed_api_key
# 若配置了 EMBED_BASE_URL，则走 OpenAI 兼容接口（如阿里云 MaaS）
EMBED_BASE_URL=

# ========== Agent 行为（可选） ==========
MAX_TOOL_ITERATIONS=5
TAVILY_MAX_RESULTS=5
RAG_SCORE_THRESHOLD=0.85
CHUNK_STRATEGY=semantic
MAX_VERIFY_ROUNDS=2
RESEARCHER_CONCURRENCY=3
MAX_TASK_RETRIES=2
